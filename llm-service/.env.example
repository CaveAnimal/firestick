# CodeLlama LLM Service Configuration

# Model Configuration
MODEL_NAME=meta-llama/Llama-2-7b-chat-hf
MODEL_CACHE_DIR=./models
TORCH_HOME=./models
DEVICE=cpu

# Service Configuration
LLM_SERVICE_PORT=8001
LLM_SERVICE_HOST=127.0.0.1

# Generation Parameters
MAX_TOKENS=512
LLM_N_CTX=2048
# Endpoint token overrides - adjust for your resources
LLM_EXPLAIN_MAX_TOKENS=400
LLM_DOCUMENT_MAX_TOKENS=800
LLM_PATTERNS_MAX_TOKENS=300
LLM_ANALYZE_MAX_TOKENS=500
TEMPERATURE=0.7
TOP_P=0.9
TIMEOUT_SECONDS=30

# Cache Configuration
CACHE_MAX_SIZE=1000
CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=INFO
